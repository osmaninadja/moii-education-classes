{
    "name": "moii/education-classes",
    "description": "Moii Classes management package",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Antigravity",
            "email": "antigravity@google.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "moii/users": "dev-main",
        "moii/hooks": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "Moii\\EducationClasses\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moii\\EducationClasses\\Database\\Factories\\": "database/factories/",
            "Moii\\EducationClasses\\Database\\Seeders\\": "database/seeders/",
            "Moii\\EducationClasses\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moii\\EducationClasses\\Providers\\ClassesServiceProvider"
            ]
        }
    }
}

